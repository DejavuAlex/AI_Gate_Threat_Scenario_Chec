# Docker host port. The app still listens on container port 8000, but the
# host publishes 18080 by default to avoid conflicts with common local services.
AI_SECURITY_GATE_HOST_PORT=18080

# Optional API docs host port. This exposes the same FastAPI app docs at /docs.
AI_SECURITY_GATE_DOCS_PORT=18081

# Shared key for external API task submission and CI/CD pipeline calls.
# Local CLI agents do not need this key.
AI_SECURITY_GATE_API_KEY=replace-with-your-api-key

AI_LLM_ENABLED=false
AI_PROVIDER=openai
OPENAI_MODEL=gpt-5-2025-08-07
OPENAI_BASE_URL=https://eu.aigw.galileo.roche.com/v1
OPENAI_API_KEY=replace-with-your-secret-key
LLM_MATCHING_TEMPERATURE=0
LLM_MATCHING_TIMEOUT_SECONDS=60

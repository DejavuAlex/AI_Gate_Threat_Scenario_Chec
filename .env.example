# Docker host port. The app still listens on container port 8000, but the
# host publishes 18080 by default to avoid conflicts with common local services.
AI_SECURITY_GATE_HOST_PORT=18080

# Optional API docs host port. This exposes the same FastAPI app docs at /docs.
AI_SECURITY_GATE_DOCS_PORT=18081

# Shared key for external API task submission and CI/CD pipeline calls.
# Local CLI agents do not need this key.
AI_SECURITY_GATE_API_KEY=replace-with-your-api-key

AI_LLM_ENABLED=false
AI_PROVIDER=openai
OPENAI_MODEL=gpt-5-2025-08-07
OPENAI_BASE_URL=https://eu.aigw.galileo.roche.com/v1
OPENAI_API_KEY=replace-with-your-secret-key
LLM_MATCHING_TEMPERATURE=0
LLM_MATCHING_TIMEOUT_SECONDS=60

# Jira integration for the "Send to Jira" button on the report review page.
# Leave empty to disable; the button then returns a configuration hint instead.
# JIRA_BASE_URL must use https so the API token is never sent in clear text.
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_PROJECT_KEY=SEC
JIRA_EMAIL=replace-with-your-jira-account-email
JIRA_API_TOKEN=replace-with-your-jira-api-token
JIRA_ISSUE_TYPE=Task
JIRA_TIMEOUT_SECONDS=30
# Optional: override the issue's default Security Level id if the project's
# default level would hide new issues from the reporting account/dashboards.
JIRA_SECURITY_LEVEL_ID=
# Optional: set to false to disable TLS certificate verification (not
# recommended; only for trusted internal Jira instances with self-signed certs).
JIRA_VERIFY_SSL=true
# Optional: timeout (seconds) for issue create/read requests.
JIRA_REQUEST_TIMEOUT=30
# Optional: timeout (seconds) for uploading the report as an attachment.
JIRA_ATTACHMENT_TIMEOUT=60
# Optional: max attachment size in bytes (default 20 MiB).
JIRA_ATTACHMENT_MAX_BYTES=20971520
